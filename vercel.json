{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 20,
      "includeFiles": "{src/filmgraph/**,data/deploy.sqlite3.gz}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
