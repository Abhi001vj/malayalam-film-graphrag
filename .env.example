# Set after creating the dedicated project and deploying the signed gateway.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
FILMGRAPH_GATEWAY_SECRET="A_PRIVATE_RANDOM_32_BYTE_OR_LONGER_SECRET"
# Optional local paths; never deploy data/accounts.sqlite3.
FILMGRAPH_ACCOUNTS_DB="data/accounts.sqlite3"

# GraphRAG backends (all optional; everything falls back to the SQLite mirror + rules/classifier).
# Local Neo4j from docker-compose.yml, or AuraDB Free: NEO4J_URI="neo4j+s://<id>.databases.neo4j.io"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="filmgraph-local"
# auto | neo4j | sqlite
FILMGRAPH_GRAPH="auto"
# ollama (default, local) | openai (any OpenAI-compatible endpoint) | none
FILMGRAPH_LLM="ollama"
FILMGRAPH_LLM_MODEL="gemma4-e4b-32k:latest"
FILMGRAPH_EMBED_MODEL="embeddinggemma"
# Optional human-handover channel
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Local demo only: raise the per-day guest query limit (hosted limits are enforced by the gateway)
# FILMGRAPH_LOCAL_GUEST_LIMIT="500"
